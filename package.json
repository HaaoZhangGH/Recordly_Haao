{
	"name": "recordly",
	"productName": "Recordly",
	"description": "Apple Silicon Mac screen recorder and editor with auto-zoom, cursor effects, backgrounds, annotations, and local captions.",
	"author": "webadderall",
	"homepage": "https://github.com/HaaoZhangGH/Recordly_Haao",
	"repository": {
		"type": "git",
		"url": "https://github.com/HaaoZhangGH/Recordly_Haao.git"
	},
	"bugs": {
		"url": "https://github.com/HaaoZhangGH/Recordly_Haao/issues"
	},
	"private": true,
	"version": "1.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"postinstall": "node scripts/postinstall.mjs",
		"build": "npm run build:mac",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"preview": "vite preview --config vite.config.ts",
		"build:native-helpers": "node scripts/build-native-helpers.mjs",
		"build:whisper-runtime": "node scripts/build-whisper-runtime.mjs",
		"build:platform-native-helpers": "npm run build:whisper-runtime && npm run build:native-helpers",
		"build:mac": "npm run build:mac:prepare && electron-builder --mac --arm64 --publish never",
		"i18n:check": "node scripts/i18n-check.mjs",
		"benchmark:export-queues": "node scripts/benchmark-export-queues.mjs",
		"normalize:electron-main-cjs": "node scripts/normalize-electron-main-cjs.mjs",
		"smoke:electron-main-cjs": "node scripts/smoke-electron-main-cjs.mjs",
		"smoke:packaged-binaries": "node scripts/smoke-packaged-binaries.mjs",
		"verify:macos-distribution": "node scripts/verify-macos-distribution.mjs",
		"checksums:release": "node scripts/write-release-checksums.mjs",
		"release:create": "node scripts/create-release.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"test:ui": "playwright test",
		"dev:ui": "vite --mode ui --host 127.0.0.1",
		"build:mac:prepare": "npm run build:platform-native-helpers && tsc && vite build --config vite.config.ts && npm run normalize:electron-main-cjs && npm run smoke:electron-main-cjs",
		"build:mac:local": "node scripts/build-local-mac.mjs"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@solar-icons/react": "^2.3.0",
		"@supabase/supabase-js": "^2.116.0",
		"electron-updater": "^6.8.3",
		"ffmpeg-static": "^5.3.0",
		"ffprobe-static": "^3.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@dnd-kit/core": "^6.3.1",
		"@fix-webm-duration/fix": "^1.0.1",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/gif.js": "^0.2.5",
		"@types/node": "^25.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.2.1",
		"clsx": "^2.1.1",
		"dnd-timeline": "^2.2.0",
		"electron": "^43.1.0",
		"electron-builder": "^26.7.0",
		"emoji-picker-react": "^4.16.1",
		"fast-check": "^4.5.2",
		"gif.js": "^0.2.0",
		"mediabunny": "^1.25.1",
		"motion": "^12.23.24",
		"mp4box": "^2.2.0",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.14.0",
		"postcss": "^8.5.6",
		"react": "^19.3.0",
		"react-aria": "3.52.1",
		"react-dom": "^19.3.0",
		"react-icons": "^5.5.0",
		"react-resizable-panels": "^3.0.6",
		"react-rnd": "^10.5.2",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"terser": "^5.44.1",
		"typescript": "^5.2.2",
		"vite": "^5.1.6",
		"vite-plugin-electron": "^0.28.6",
		"vite-plugin-electron-renderer": "^0.14.5",
		"vitest": "^3.2.7",
		"web-demuxer": "^4.0.0"
	},
	"main": "dist-electron/main.cjs"
}
